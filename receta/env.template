# .env de Utopia Tickets (Hi.Events v2.2.0 + capa de marca). Solo marcadores: setup.sh genera los secretos.
# Cambia tickets.example.com por tu dominio público. El .env nunca va al repositorio.
PUBLIC_URL=https://tickets.example.com
APP_KEY=__APP_KEY__
JWT_SECRET=__JWT_SECRET__
POSTGRES_PASSWORD=__PG_PASSWORD__
VITE_FRONTEND_URL=https://tickets.example.com
VITE_API_URL_CLIENT=https://tickets.example.com/api
VITE_API_URL_SERVER=http://localhost/api
VITE_APP_NAME=Utopia Tickets
VITE_COOKIE_CONSENT_ENABLED=false
LOG_CHANNEL=stderr
QUEUE_CONNECTION=redis
APP_NAME=Utopia Tickets
APP_URL=https://tickets.example.com
APP_CDN_URL=https://tickets.example.com/storage
APP_FRONTEND_URL=https://tickets.example.com
APP_DISABLE_REGISTRATION=false
# IP del proxy TLS o del túnel que tengas delante (o * si solo te llega tráfico a través de él)
APP_TRUSTED_PROXIES=*
APP_LICENCE_KEY=

# Modo SaaS con Stripe Connect: comisión de la plataforma de 0,50 € + 21 % de IVA por entrada de pago
APP_SAAS_MODE_ENABLED=true
APP_STRIPE_CONNECT_ACCOUNT_TYPE=standard
APP_SAAS_STRIPE_APPLICATION_FEE_PERCENT=0
APP_SAAS_STRIPE_APPLICATION_FEE_FIXED=0.5
APP_SAAS_DEFAULT_PASS_PLATFORM_FEE_TO_BUYER=false
APP_TAX_EU_VAT_HANDLING_ENABLED=true
APP_TAX_DEFAULT_VAT_RATE=0.21
APP_TAX_DEFAULT_VAT_COUNTRY=ES
APP_PLATFORM_SUPPORT_EMAIL=tickets@utopiabooking.com
APP_EMAIL_LOGO_LINK_URL=https://tickets.example.com

# Correo: con el compose tal cual, todo lo recoge Mailpit. Para correo real, pon aquí tu proveedor SMTP.
MAIL_MAILER=smtp
MAIL_DRIVER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=null
MAIL_AUTO_TLS=false
MAIL_VERIFY_PEER=false
MAIL_FROM_ADDRESS=tickets@utopiabooking.com
MAIL_FROM_NAME="Utopia Tickets"
FILESYSTEM_PUBLIC_DISK=public
FILESYSTEM_PRIVATE_DISK=local
GEO_PROVIDER=google
GOOGLE_MAPS_API_KEY=
API_DOCS_ENABLED=false

# Stripe: tus claves (empieza con las de prueba). Aquí solo hay marcadores.
VITE_STRIPE_PUBLISHABLE_KEY=__STRIPE_PUBLICA__
STRIPE_PUBLIC_KEY=__STRIPE_PUBLICA__
STRIPE_SECRET_KEY=__STRIPE_SECRETA__
STRIPE_WEBHOOK_SECRET=__STRIPE_WEBHOOK__

# Antiabuso del registro (Cloudflare Turnstile, opcional): vacías = desactivado
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=

# Capa de marca (branding/, montada por el compose)
APP_LOCALE=es
VITE_APP_LOGO_LIGHT=/utopia/logo/utopia-tickets-horizontal-negativo.svg
VITE_APP_LOGO_DARK=/utopia/logo/utopia-tickets-horizontal-positivo.svg
VITE_APP_FAVICON=/utopia/favicon/favicon.svg
VITE_APP_PRIMARY_COLOR=#1F6F66
VITE_APP_SECONDARY_COLOR=#B8430F
VITE_TOS_URL=/utopia/legal/condiciones-de-compra.html
VITE_PRIVACY_URL=/utopia/legal/privacidad.html
VITE_DEFAULT_IMAGE_URL=/utopia/evento/portada-generica.jpg
# Logo de los correos: URL absoluta pública
APP_EMAIL_LOGO_URL=https://tickets.example.com/utopia/email/email-logo@2x.png

# Alta libre de promotores: buzón (o varios, separados por comas) que recibe el aviso de cada alta nueva, y fichero
# con la versión y la huella de los documentos que se aceptan (lo genera branding/paginas/gen_paginas.py).
UTOPIA_AVISO_ALTAS=altas@tickets.example.com
UTOPIA_LEGAL_VERSIONES=/branding/public/legal/versiones.json
